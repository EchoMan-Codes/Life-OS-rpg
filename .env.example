# Server
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Database (Neon)
DATABASE_URL=postgres://user:pass@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DIRECT_DATABASE_URL=postgres://user:pass@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Auth
JWT_ACCESS_SECRET=replace_with_openssl_rand_hex_32
JWT_REFRESH_SECRET=replace_with_a_different_openssl_rand_hex_32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Email (pick one block)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# RESEND_API_KEY=

# AI Configuration (Gemini, OpenAI, or Local/Ollama)
# Supported options: 'gemini', 'openai', 'local'
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Option B: OpenAI API
# AI_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Option C: Local LLM (Ollama / LM Studio / LocalAI OpenAI-compatible endpoints)
# AI_PROVIDER=local
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.2
# OPENAI_API_KEY=ollama (or any dummy string)

# Web Push (VAPID) Configuration
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@jeevan.app

# Client (Vite — must be prefixed VITE_)
VITE_API_BASE_URL=http://localhost:5000/api/v1
